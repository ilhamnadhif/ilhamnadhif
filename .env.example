# Port the site listens on. "3003" is public; "127.0.0.1:3000" keeps it behind a reverse proxy.
WEB_PORT=3000

# Public URL, used for canonical and Open Graph links.
SITE_URL=https://example.com

# Dashboard login. Generate both lines with: npm run hash-password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Set to "false" while the site is served over plain http (no domain/HTTPS yet).
# COOKIE_SECURE=false

# Only for the optional Caddy HTTPS front: docker compose --profile https up -d
# DOMAIN=example.com

# Optional: where content.json, uploads/ and backups/ are stored (default ./data).
# DATA_DIR=/app/data
